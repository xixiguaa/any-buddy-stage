[docker]
# read_write（默认）任务共享同一个本地 Docker 沙箱；full_access 直接使用本地 Shell。
# 默认镜像同时提供 Python 3.12 与 Node.js 22；可替换为本机可拉取的镜像。
# image=nikolaik/python-nodejs:python3.12-nodejs22-slim
# image_type=combined

# 本地 Docker CLI 的命令超时、命令输出和文件传输上限。
# timeout_ms=120000
# max_output_bytes=1048576
# max_transfer_bytes=67108864
